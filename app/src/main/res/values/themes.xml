<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.Keymapper" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/k2er_purple</item>
        <item name="colorPrimaryDark">@color/k2er_purple_dark</item>
        <item name="colorAccent">@color/k2er_purple_light</item>
        <item name="android:windowBackground">@color/k2er_bg</item>
        <item name="android:statusBarColor">@color/k2er_purple_dark</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="Theme.Keymapper.Picker" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowFullscreen">true</item>
    </style>
</resources>
