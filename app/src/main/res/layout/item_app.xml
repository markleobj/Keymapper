<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_k2er_app_card"
    android:padding="16dp"
    android:layout_marginBottom="12dp">

    <ImageView
        android:id="@+id/appIcon"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:scaleType="centerCrop"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:contentDescription="app icon" />

    <TextView
        android:id="@+id/appName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:text="梦幻西游"
        android:textColor="@color/k2er_text"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintStart_toEndOf="@id/appIcon"
        app:layout_constraintTop_toTopOf="@id/appIcon"
        app:layout_constraintEnd_toStartOf="@id/appDot" />

    <ImageView
        android:id="@+id/appDot"
        android:layout_width="14dp"
        android:layout_height="14dp"
        android:layout_marginStart="6dp"
        android:src="@drawable/ic_dot_red"
        android:visibility="gone"
        app:layout_constraintStart_toEndOf="@id/appName"
        app:layout_constraintTop_toTopOf="@id/appName"
        app:layout_constraintBottom_toTopOf="@id/appName"
        android:contentDescription="badge" />

    <TextView
        android:id="@+id/appSummary"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_marginTop="4dp"
        android:text="2 个映射 · 场景: 全局"
        android:textColor="@color/k2er_text_secondary"
        android:textSize="13sp"
        app:layout_constraintStart_toEndOf="@id/appIcon"
        app:layout_constraintTop_toBottomOf="@id/appName"
        app:layout_constraintEnd_toStartOf="@id/btnStart"
        app:layout_constraintBottom_toBottomOf="@id/appIcon" />

    <TextView
        android:id="@+id/btnStart"
        android:layout_width="wrap_content"
        android:layout_height="44dp"
        android:minWidth="80dp"
        android:paddingHorizontal="24dp"
        android:gravity="center"
        android:text="开始"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:textStyle="bold"
        android:background="@drawable/bg_k2er_button"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/appIcon"
        app:layout_constraintBottom_toBottomOf="@id/appIcon"
        android:clickable="true"
        android:focusable="true" />

</androidx.constraintlayout.widget.ConstraintLayout>
